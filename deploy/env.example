# Skopiuj do deploy/.env i uzupełnij. Plik .env NIE trafia do repo (jest w .gitignore).

# Domena, pod którą stoi gra. Bez https:// i bez portu.
DOMAIN=barberstrike.click

# Mail do Let's Encrypt — dostaniesz ostrzeżenie, gdyby certyfikat kiedyś nie chciał się odnowić.
ACME_EMAIL=aleksander.cucumber@gmail.com

# Hasło do panelu admina turnieju na /viewer (zakładanie turnieju). Puste = panel otwarty dla
# każdego (tylko na czas developmentu). Na produkcji USTAW własne hasło.
ADMIN_PASSWORD=
