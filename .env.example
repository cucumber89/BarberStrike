# --- server (apps/server) ---
# Port for the Colyseus WebSocket/HTTP server
PORT=2567
# Allowed CORS origin for the client (comma separated). Leave empty to allow all (dev).
CORS_ORIGIN=
# DEV ONLY: registers the "dev:teleport" room message used by the e2e suite. Never set in production.
FB_DEV_TOOLS=
# DEV ONLY: log outgoing bandwidth per room every 5 s (bytes/s total and per client).
FB_NET_STATS=

# --- client (apps/client) ---
# WebSocket endpoint of the game server. Empty = same host as the page, port 2567 in dev.
VITE_SERVER_URL=
# Show the development overlay (FPS/ping/etc). Never enable in production builds.
VITE_DEBUG_OVERLAY=false
